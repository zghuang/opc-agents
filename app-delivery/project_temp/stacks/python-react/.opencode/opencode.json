{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "default_agent": "build",
  "instructions": [
    "AGENTS.md",
    "frontend/FRONTEND-RULES.md"
  ],
  "plugin": [
    "./opc-guard.js"
  ],
  "permission": {
    "read": "allow",
    "list": "allow",
    "glob": "allow",
    "grep": "allow",
    "edit": "allow",
    "bash": "allow",
    "webfetch": "allow",
    "skill": "allow"
  },
  "tool_output": {
    "max_lines": 2000,
    "max_bytes": 51200
  }
}
