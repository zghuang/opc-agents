# Copy to .env and fill in real values. Never commit .env to git.
# SQLAlchemy async engine uses the asyncpg driver for PostgreSQL.
DATABASE_URL=postgresql+asyncpg://opc_user:password@localhost:5432/app_db
REDIS_URL=redis://localhost:6379/0
SECRET_KEY=replace-with-64-char-random-string-use-openssl-rand-hex-32
ENVIRONMENT=development

# External APIs (points to mock server during development/testing)
EXTERNAL_API_BASE_URL=http://localhost:8888