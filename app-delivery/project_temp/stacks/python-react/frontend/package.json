    "antd": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.14",
    "@vitejs/plugin-react": "^6.0.2",
    "vitest": "^4.1.7",
    "@vitest/coverage-v8": "^4.1.7",
    "jsdom": "^29.1.1",
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/user-event": "^14.6.1",
    "eslint": "^10.4.0",
    "typescript-eslint": "^8.60.0",
